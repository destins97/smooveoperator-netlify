      "css": ".ds-label{font-family:var(--body,Barlow,system-ui,sans-serif);font-size:17px;display:block;color:var(--text,#f0eee7);font-weight:500;margin-bottom:9px}.ds-input{font-family:var(--body,Barlow,system-ui,sans-serif);font-size:17px;font-size:18px;line-height:1.45;width:100%;min-height:49px;padding:12px 14px;border:1px solid var(--control,#77796b);border-radius:0;background:var(--black,#0a0a0a);color:var(--text,#f0eee7)}.ds-input:focus-visible{outline:2px solid var(--gold-light,#e5c974);outline-offset:5px;outline-offset:3px}.ds-input[aria-invalid=true]{border-color:var(--error,#f3b4a8)}"
