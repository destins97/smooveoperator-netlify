      "css": ".ds-nav{display:flex;gap:27px}.ds-nav a{font-family:var(--body,Barlow,system-ui,sans-serif);font-size:17px;font-size:16px;display:inline-flex;min-height:44px;align-items:center;color:var(--muted,#b0afa4);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--gold-light,#e5c974)}.ds-nav a[aria-current=page]{box-shadow:inset 0 -1px var(--gold,#C5A028)}.ds-nav a:focus-visible{outline:2px solid var(--gold-light,#e5c974);outline-offset:5px}"
