      "css": ".ds-text{font-family:var(--body,Barlow,system-ui,sans-serif);font-size:17px;display:inline-flex;align-items:center;min-height:50px;padding:13px 0;color:var(--text,#f0eee7);border-bottom:1px solid var(--control,#77796b);font-weight:500;text-decoration:none}.ds-text:hover{color:var(--gold-light,#e5c974);border-color:var(--gold,#C5A028)}.ds-text:focus-visible{outline:2px solid var(--gold-light,#e5c974);outline-offset:5px}.ds-text:active{transform:translateY(1px)}"
