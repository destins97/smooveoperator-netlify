      "html": "<a class=\"ds-primary\" href=\"#supplier\">For brands &amp; suppliers <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-primary{font-family:var(--body,Barlow,system-ui,sans-serif);font-size:17px;display:inline-flex;align-items:center;gap:18px;min-height:50px;padding:13px 22px;background:var(--gold,#C5A028);color:var(--black,#0a0a0a);border:1px solid var(--gold,#C5A028);font-weight:500;line-height:1.4;text-decoration:none;transition:background 220ms cubic-bezier(.22,1,.36,1)}.ds-primary:hover{background:var(--gold-light,#e5c974)}.ds-primary:focus-visible{outline:2px solid var(--gold-light,#e5c974);outline-offset:5px}.ds-primary:active{transform:translateY(1px)}"
